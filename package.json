{
  "name": "@open-amt-cloud-toolkit/ui-toolkit",
  "version": "3.3.20",
  "description": "UI controls for Intel AMT features",
  "main": "index.js",
  "scripts": {
    "prepublishOnly": "cp package.json dist",
    "start": "webpack serve --config webpack.config.dev.js",
    "build": "webpack --config webpack.config.prod.js",
    "build-ext": "npm run build-types && webpack --config webpack.config.externals.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "coverage": "vitest run --coverage --exclude=src/test/imagehelper.spec.ts --exclude=src/test/rledecoder.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build-types": "tsc --emitDeclarationOnly -p tsconfig.build.json",
    "prettify": "npx prettier --write .",
    "ci-prettify": "npx prettier --check ."
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/device-management-toolkit/ui-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/device-management-toolkit/ui-toolkit.git"
  },
  "homepage": "https://github.com/device-management-toolkit/ui-toolkit#readme",
  "types": "index.d.ts",
  "dependencies": {
    "md5": "^2.2.1",
    "ws": "^8.2.1"
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^7.0.1",
    "brace-expansion": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint-scope": "^9.1.0",
    "@types/md5": "^2.1.33",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-loader": "^10.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.2",
    "filereader": "^0.10.3",
    "jsdom": "^30.0.1",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-multiline-arrays": "^4.0.3",
    "ts-loader": "^9.2.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^4.1.11",
    "webpack": "^5.40.0",
    "webpack-cli": "^7.0.2",
    "webpack-node-externals": "^3.0.0"
  }
}
