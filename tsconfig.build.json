{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "types": ["node"],
    // skipLibCheck is only relaxed in tsconfig.json for the test/typecheck
    // config; keep declaration builds strict.
    "skipLibCheck": false
  },
  "exclude": [
    "./src/test/**/*",
    "vitest.setup.ts"
  ]
}
